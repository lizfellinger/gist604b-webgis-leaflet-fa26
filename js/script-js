// 1. Initialize the map centered on your area of interest [Latitude, Longitude], Zoom Level
const map = L.map('map', {
    center: [38.9072, -77.0369], // Example: Washington, D.C.
    zoom: 12,
    zoomControl: false // Disabled here so we can explicitly add/position it below
});

// 2. Add a basemap layer (OpenStreetMap is free and requires no API key)
const osmBasemap = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
}).addTo(map);

// 3. Add zoom controls and a scale bar
L.control.zoom({ position: 'topleft' }).addTo(map);
L.control.scale({ imperial: true, metric: true }).addTo(map);

// 4. Create Layer Groups to organize your datasets
const dataset1Group = L.layerGroup().addTo(map);

// 5. Load GeoJSON datasets, apply styling, and add popups
// NOTE: You must run this using a local server (like VS Code "Live Server") for fetch() to work!
fetch('data/your-dataset.geojson')
    .then(response => response.json())
    .then(data => {
        L.geoJSON(data, {
            // Apply basic styling (for lines and polygons)
            style: function (feature) {
                return {
                    color: "#2b5c8f",      // Outline color
                    weight: 2,             // Outline thickness
                    fillColor: "#4a90e2",  // Fill color
                    fillOpacity: 0.5       // Fill transparency
                };
            },
            // Add a popup using feature attributes
            onEachFeature: function (feature, layer) {
                // Replace 'NAME' with an actual property name from your GeoJSON file
                if (feature.properties && feature.properties.NAME) {
                    layer.bindPopup(`<strong>Name:</strong> ${feature.properties.NAME}`);
                }
            }
        }).addTo(dataset1Group); // Add the GeoJSON layer into your Layer Group
    })
    .catch(error => console.error('Error loading GeoJSON:', error));

// Optional: Add a Layer Control toggle in the top right so users can turn layer groups on/off
const baseMaps = { "OpenStreetMap": osmBasemap };
const overlayMaps = { "My Dataset": dataset1Group };
L.control.layers(baseMaps, overlayMaps).addTo(map);